+def test_off_mode_refuses_every_decision(client, monkeypatch):
+    monkeypatch.setenv("OSC_SHARE_DECISION_MODE", "off")
+    with patch(f"{M}.validate_share_link_with_session", return_value=_link(SharePermission.approve)):
+        r = client.post("/share/tok/decision", json={"decision": "approved", "guest_name": "A", "guest_email": "a@x.com"})
+    assert r.status_code == 403
+
+
+def test_mode_defaults_to_binding_and_ignores_junk(monkeypatch):
+    from apps.api.routers import osc_share_decision as m
+    monkeypatch.delenv("OSC_SHARE_DECISION_MODE", raising=False)
+    assert m.mode() == "binding"
+    monkeypatch.setenv("OSC_SHARE_DECISION_MODE", "OK ")
+    assert m.mode() == "ok"
+    monkeypatch.setenv("OSC_SHARE_DECISION_MODE", "maybe")
+    assert m.mode() == "binding"
+
+
